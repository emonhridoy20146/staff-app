# Live test server: the owner's field-api deployment (field-api ADR-034).
# Used by the Android Studio run configurations in .run/ and by
#   flutter build apk --release --dart-define-from-file=config/live.env
#
# Committed on purpose (ADR-M16): public, non-secret values only. Never add a
# token, key, password or DSN here; those stay in git-ignored .env.* files or
# CI secrets (CLAUDE.md §2.13). The app talks only to field-api, never to the
# ERP. test/core/live_config_test.dart fails the build if this file breaks
# these rules.
APP_ENV=staging
API_BASE_URL=https://howlader-apps-api.vercel.app/api/v1
API_MODE=live
